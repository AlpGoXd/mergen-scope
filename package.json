{
  "name": "mergen-scope",
  "version": "0.5.0",
  "description": "Browser-based RF signal analysis tool",
  "type": "module",
  "scripts": {
    "prepare": "node scripts/install-git-hooks.cjs",
    "dev": "vite",
    "clean:dist": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:fast": "playwright test --grep-invert @slow",
    "test:static": "playwright test --config=playwright.static.config.ts",
    "capture:landing": "node scripts/refresh-landing-assets.mjs",
    "test": "npm run test:unit && npm run test:e2e"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlpGoXd/mergen-scope.git"
  },
  "keywords": [
    "oscilloscope",
    "spectrum-analyzer",
    "touchstone",
    "s-parameters",
    "smith-chart",
    "vna",
    "waveform-viewer",
    "rf"
  ],
  "author": "",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/AlpGoXd/mergen-scope/issues"
  },
  "homepage": "https://github.com/AlpGoXd/mergen-scope#readme",
  "dependencies": {
    "@chenglou/pretext": "^1.0.0",
    "jspdf": "4.2.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^2.15.3",
    "svg2pdf.js": "2.9.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.5.2",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "jsdom": "^29.1.1",
    "playwright": "^1.60.0",
    "typescript": "^6.0.2",
    "vite": "^7.0.0",
    "vite-plugin-singlefile": "^2.3.2",
    "vitest": "^4.1.7"
  }
}
